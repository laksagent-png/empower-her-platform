# Firebase Configuration
#
# LOCAL DEVELOPMENT
#   Copy this file to .env.local and fill in your Firebase project credentials.
#   .env.local is listed in .gitignore and will never be committed.
#
# CI/CD (GitHub Actions)
#   Do NOT embed real credentials here or in any committed file.
#   Instead, add each variable below as a GitHub Actions Secret:
#     Repository → Settings → Secrets and variables → Actions → New repository secret
#   The deploy workflow reads these secrets and injects them as environment
#   variables at build time so they are never stored in the repository.
#
# WARNING: Never commit real API keys or credentials to version control.

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
