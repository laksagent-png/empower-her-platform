rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Events collection:
    // - Anyone (including unauthenticated visitors) can read events so the
    //   public homepage and event-detail pages work without login.
    // - Only authenticated users (admins) can create, update, or delete events.
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Stats collection (e.g. stats/impact):
    // - Public read so the public-facing ImpactSection can display dynamic metrics.
    // - Only authenticated admins can write (create/update via the admin dashboard).
    match /stats/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Settings collection (e.g. settings/contribution):
    // - Public read so the public-facing ContributionHub can display bank/UPI details.
    // - Only authenticated admins can write (create/update via the admin dashboard).
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // All other collections are denied by default.
  }
}
